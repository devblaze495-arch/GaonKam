generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  USER
  ADMIN
}

enum LanguageCode {
  MR
  HI
  EN
}

enum AccountStatus {
  ACTIVE
  PENDING_REVIEW
  SUSPENDED
  DEACTIVATED
}

enum JobStatus {
  DRAFT
  OPEN
  APPLICATIONS_RECEIVED
  WORKERS_SELECTED
  IN_PROGRESS
  COMPLETION_PENDING
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  NO_SHOW
}

enum JobApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum WageType {
  DAILY
  HOURLY
  FIXED
  NEGOTIABLE
}

enum VehicleType {
  AUTO
  PICKUP
  TRACTOR
  BUS
  OTHER
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum ServiceAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum CompletionStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  users UserRole[]
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  fullName          String
  email             String?       @unique
  passwordHash      String
  profilePhoto      String?
  mobile            String?
  village           String?
  district          String?
  state             String?
  latitude          Decimal?      @db.Decimal(9, 6)
  longitude         Decimal?      @db.Decimal(9, 6)
  preferredLanguage LanguageCode  @default(MR)
  accountStatus     AccountStatus @default(ACTIVE)
  // Trust score is stored here; trust/reputation calculations belong in a dedicated backend service.
  trustScore        Int           @default(0)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  roles             UserRole[]
  skills            UserSkill[]
  postedJobs        Job[]             @relation("JobPoster")
  jobApplications   JobApplication[]  @relation("Applicant")
  assignments       JobAssignment[]   @relation("AssignedWorker")
  reviewsWritten    Rating[]          @relation("Reviewer")
  reviewsReceived   Rating[]          @relation("ReviewedUser")
  raisedDisputes    Dispute[]         @relation("DisputeRaisedBy")
  disputedAgainst   Dispute[]         @relation("DisputeAgainst")
  resolvedDisputes  Dispute[]         @relation("DisputeResolvedBy")
  servicesOffered   Service[]         @relation("ServiceProvider")
  completionsMarked JobCompletion[]   @relation("CompletionMarkedBy")
  availability      UserAvailability?
}

model UserAvailability {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @db.Uuid
  status    AvailabilityStatus @default(AVAILABLE)
  notes     String?
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Skill {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  users UserSkill[]
  jobs  JobSkill[]
}

model UserSkill {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  skillId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model JobCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  jobs Job[]
}

model Job {
  id                       String       @id @default(uuid()) @db.Uuid
  posterId                 String       @db.Uuid
  categoryId               String       @db.Uuid
  title                    String
  description              String
  village                  String?
  district                 String?
  state                    String?
  latitude                 Decimal?     @db.Decimal(9, 6)
  longitude                Decimal?     @db.Decimal(9, 6)
  workDate                 DateTime?    @db.Date
  startTime                DateTime?    @db.Timestamptz(3)
  estimatedDurationMinutes Int?
  wageType                 WageType     @default(NEGOTIABLE)
  wageAmount               Decimal?     @db.Decimal(10, 2)
  currency                 String       @default("INR")
  isWageNegotiable         Boolean      @default(true)
  wageNotes                String?
  transportationProvided   Boolean      @default(false)
  vehicleType              VehicleType?
  vehicleCapacity          Int?
  transportNotes           String?
  applicationDeadline      DateTime?    @db.Timestamptz(3)
  status                   JobStatus    @default(OPEN)
  numberOfWorkers          Int          @default(1)
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @db.Timestamptz(3)

  poster       User             @relation("JobPoster", fields: [posterId], references: [id], onDelete: Restrict)
  category     JobCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  skills       JobSkill[]
  applications JobApplication[]
  assignments  JobAssignment[]
  completions  JobCompletion[]
  ratings      Rating[]
  disputes     Dispute[]

  @@index([posterId])
  @@index([categoryId])
  @@index([status])
  @@index([applicationDeadline])
  @@index([workDate])
}

model JobSkill {
  id      String @id @default(uuid()) @db.Uuid
  jobId   String @db.Uuid
  skillId String @db.Uuid

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
}

model JobApplication {
  id          String               @id @default(uuid()) @db.Uuid
  jobId       String               @db.Uuid
  applicantId String               @db.Uuid
  message     String?
  status      JobApplicationStatus @default(PENDING)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  job         Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  applicant   User            @relation("Applicant", fields: [applicantId], references: [id], onDelete: Restrict)
  assignments JobAssignment[]

  @@unique([jobId, applicantId])
  @@index([jobId, status])
  @@index([applicantId, status])
}

model JobAssignment {
  id            String           @id @default(uuid()) @db.Uuid
  jobId         String           @db.Uuid
  workerId      String           @db.Uuid
  applicationId String?          @db.Uuid
  status        AssignmentStatus @default(PENDING)
  selectedAt    DateTime         @default(now()) @db.Timestamptz(3)
  acceptedAt    DateTime?        @db.Timestamptz(3)
  declinedAt    DateTime?        @db.Timestamptz(3)
  cancelledAt   DateTime?        @db.Timestamptz(3)
  noShowAt      DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  job         Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  worker      User            @relation("AssignedWorker", fields: [workerId], references: [id], onDelete: Restrict)
  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  completion  JobCompletion?
  disputes    Dispute[]

  @@unique([jobId, workerId])
  @@index([jobId, status])
  @@index([workerId, status])
}

model JobCompletion {
  id                String           @id @default(uuid()) @db.Uuid
  assignmentId      String           @unique @db.Uuid
  jobId             String           @db.Uuid
  markedById        String           @db.Uuid
  status            CompletionStatus @default(PENDING)
  markedAt          DateTime?        @db.Timestamptz(3)
  workerConfirmedAt DateTime?        @db.Timestamptz(3)
  posterConfirmedAt DateTime?        @db.Timestamptz(3)
  note              String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  assignment JobAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  markedBy   User          @relation("CompletionMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)

  @@index([jobId])
  @@index([markedById])
  @@index([status])
}

model Rating {
  id             String   @id @default(uuid()) @db.Uuid
  jobId          String   @db.Uuid
  reviewerId     String   @db.Uuid
  reviewedUserId String   @db.Uuid
  rating         Int      @db.SmallInt
  review         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  job          Job  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  reviewer     User @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewedUser User @relation("ReviewedUser", fields: [reviewedUserId], references: [id], onDelete: Restrict)

  @@unique([jobId, reviewerId, reviewedUserId])
  @@index([jobId])
  @@index([reviewedUserId])
  @@index([reviewerId])
}

model Dispute {
  id            String        @id @default(uuid()) @db.Uuid
  jobId         String        @db.Uuid
  assignmentId  String?       @db.Uuid
  raisedById    String        @db.Uuid
  againstUserId String?       @db.Uuid
  reason        String
  description   String?
  status        DisputeStatus @default(OPEN)
  resolution    String?
  resolvedById  String?       @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  resolvedAt    DateTime?     @db.Timestamptz(3)

  job         Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignment  JobAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  raisedBy    User           @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  againstUser User?          @relation("DisputeAgainst", fields: [againstUserId], references: [id], onDelete: SetNull)
  resolvedBy  User?          @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([assignmentId])
  @@index([raisedById])
  @@index([status])
}

model ServiceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  services Service[]
}

model Service {
  id           String              @id @default(uuid()) @db.Uuid
  providerId   String              @db.Uuid
  categoryId   String              @db.Uuid
  title        String
  description  String
  location     String?
  village      String?
  district     String?
  state        String?
  latitude     Decimal?            @db.Decimal(9, 6)
  longitude    Decimal?            @db.Decimal(9, 6)
  dailyRate    Decimal?            @db.Decimal(10, 2)
  availability ServiceAvailability @default(AVAILABLE)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  provider User            @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Restrict)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([categoryId])
  @@index([availability])
}
